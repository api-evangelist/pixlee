          "name": "Get approved content from album",
          "request": {
            "name": "Get approved content from album",
            "description": {
              "content": "Returns approved media content inside an album. Optionally, pass in formatted JSON to filter or sort the content. This is the most commonly used endpoint for consuming UGC.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "albums",
                ":album_id",
                "photos"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1"
                },
                {
                  "disabled": false,
                  "key": "per_page",
                  "value": "30"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<json>",
                  "description": "JSON sort object. Applicable sorts: recency, approved_time, random, pixlee_shares, pixlee_likes, popularity, dynamic (with desc | asc)."
                },
                {
                  "disabled": false,
                  "key": "filters",
                  "value": "<json>",
                  "description": "JSON filters object (intersecting clauses). See the Consuming Content guide for the full filter vocabulary (content_source, content_type, has_product, has_permission, in_categories, etc.)."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
