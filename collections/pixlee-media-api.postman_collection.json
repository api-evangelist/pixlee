  "info": {
    "_postman_id": "c8c91503-0685-4930-9618-ce5932ead498",
    "name": "Pixlee Content Albums Media API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Pixlee's Content API provides brands programmatic access to their Pixlee user-generated content (UGC), lets them consume approved media from albums with rich filtering and sorting, upload new content from a URL or a file, and add or update products. Pixlee is now part of Emplifi (Pixlee TurnTo). Authentication uses an ACCOUNT API KEY / ACCOUNT PRIVATE API KEY passed as the `api_key` query parameter; all POST (write) requests must additionally be signed with an HMAC-SHA1 `Signature` header computed from the JSON payload using the ACCOUNT SECRET KEY.\n\nContact Support:\n Name: Pixlee TurnTo Developer Support (Emplifi)",
      "type": "text/plain"
    }
  }
